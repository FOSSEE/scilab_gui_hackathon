---
import '../assets/css/custom.css';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
    <title>Congratulations</title>
      <script
  is:inline
  src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js">
</script>
    <script is:inline>
      try {
        document.documentElement.dataset.sectionTheme =
          localStorage.getItem('section-theme') === 'dark' ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.sectionTheme = 'light';
      }
    </script>
    <style>
      .center-container {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column
        /*background-color: transparent;*/

      }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      --announcement-accent: var(--color-brand-yellow);
      --announcement-heading: var(--color-brand-yellow);
      background: radial-gradient(ellipse at bottom, var(--color-brand-surface-alt), var(--color-brand-bg));
      font-family: "Nunito Sans", sans-serif;
      color: var(--color-brand-text);
      text-align: center;
      padding: 2rem;
    }

    /* :global(html[data-section-theme="light"]) body {
      --announcement-accent: var(--color-brand-cyan-dark);
      --announcement-heading: var(--color-section-light-heading);
      background: radial-gradient(ellipse at bottom, var(--color-section-light-surface-alt), var(--color-section-light-bg));
      color: var(--color-section-light-text);
    } */

    h1 {
      color: var(--announcement-heading);
      font-size: 4rem;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }

    .neon-button {
      font-size: 2rem;
      display: inline-block;
      cursor: pointer;
      color: var(--announcement-accent);
      background: transparent;
      border: var(--announcement-accent) 0.125em solid;
      padding: 0.5em 1.5em;
      border-radius: 0.25em;
      text-shadow: 
        0 0 0.125em rgba(255, 255, 255, 0.3),
        0 0 0.45em var(--announcement-accent);
      box-shadow: 
        inset 0 0 0.5em 0 var(--announcement-accent),
        0 0 0.5em 0 var(--announcement-accent);
      position: relative;
      transition: all 0.3s ease;
    }

    .neon-button::before {
      pointer-events: none;
      content: "";
      position: absolute;
      background: var(--announcement-accent);
      top: 120%;
      left: 0;
      width: 100%;
      height: 100%;
      transform: perspective(1em) rotateX(40deg) scale(1, 0.35);
      filter: blur(1em);
      opacity: 0.7;
    }

    .neon-button::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      box-shadow: 0 0 2em 0.5em var(--announcement-accent);
      opacity: 0;
      background-color: var(--announcement-accent);
      z-index: -1;
      transition: opacity 100ms linear;
    }

    .neon-button:hover,
    .neon-button:focus {
      color: var(--color-brand-ink);
      background-color: var(--color-brand-yellow);
      text-shadow: none;
    }

    .neon-button:focus-visible {
      outline: 3px solid var(--announcement-accent);
      outline-offset: 6px;
    }

    .neon-button:hover::before,
    .neon-button:focus::before {
      opacity: 1;
    }

    .neon-button:hover::after,
    .neon-button:focus::after {
      opacity: 1;
    }
    </style>
  </head>
<body>

    <div class="center-container">
<h1>Scilab GUI Hackathon 2026 Result</h1>
<br><p>&nbsp;</p>
      <button class="neon-button btn" onclick="startCountdown(this)">
        📢 Reveal Results
      </button>
<p>&nbsp;</p>
    </div>

	  <script is:inline type="text/javascript">
  function startCountdown(button) {
    button.disabled = true;

    let countdown = 3;

    // Show 3 immediately
    button.textContent = `📢 Result announcement in ${countdown}s...`;

    const interval = setInterval(() => {
      countdown--;

      if (countdown > 0) {
        button.textContent = `📢 Result announcement in ${countdown}s...`;
      } else {
        clearInterval(interval);

        button.textContent = '🎉 Congratulations!';

        celebrate();

        // Wait for confetti animation, then open results
        setTimeout(() => {
          window.location.href = '/results';
        }, 2500);
      }
    }, 1000);
  }

  function celebrate() {
    // Main center burst
    confetti({
      particleCount: 150,
      spread: 100,
      startVelocity: 45,
      origin: {
        x: 0.5,
        y: 0.6
      }
    });

    // Left side
    setTimeout(() => {
      confetti({
        particleCount: 80,
        angle: 60,
        spread: 65,
        origin: {
          x: 0,
          y: 0.7
        }
      });

      // Right side
      confetti({
        particleCount: 80,
        angle: 120,
        spread: 65,
        origin: {
          x: 1,
          y: 0.7
        }
      });
    }, 300);
  }
</script>
  </body>
</html>
