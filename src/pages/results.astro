---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { read } from 'xlsx';
import { resultRows } from '../lib/result-sheet';

// Read at build time; only rendered table content is sent to the browser.
const workbook = read(readFileSync('src/data/results.xlsx'));
const sheets = workbook.SheetNames
  .filter((_, index) => !workbook.Workbook?.Sheets?.[index]?.Hidden)
  .map(name => ({ name, rows: resultRows(workbook.Sheets[name]) }));
---
<Layout title="Scilab Case Study Hackathon">
<div class="curtain left-curtain"></div>
<div class="curtain right-curtain"></div>
<main class="site-main results-page hidden" id="main-content">
<div class="section-inner">
<h1 class="text-center section-title" id="results">Results</h1>
<div class="tabs" aria-label="Result worksheets">
  {sheets.map((sheet, index) => (
    <button type="button" class:list={['tab', { active: index === 0 }]}
      data-tab={index} aria-controls={`tab-${index}`} aria-pressed={index === 0}>
      {sheet.name}
    </button>
  ))}
</div>
<div class="tab-content">
  {sheets.map((sheet, index) => (
    <div class:list={['tab-panel', { active: index === 0 }]} id={`tab-${index}`}>
      {sheet.rows.length ? (
        <div class="table-scroll">
          <table class="modern-table" aria-label={sheet.name}>
            <tbody>
              {sheet.rows.map((row, rowIndex) => (
                <tr>
                  {row.map(cell => rowIndex === 0 ? (
                    <th rowspan={cell.rowspan} colspan={cell.colspan}>{cell.text}</th>
                  ) : (
                    <td rowspan={cell.rowspan} colspan={cell.colspan}>{cell.text}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p>No results in this worksheet yet.</p>}
      {sheet.name.trim().toLowerCase() === 'good submissions' && (
        <p class="text-lg mt-4"><mark>Note: A certificate of appreciation will be given to all the Good submissions.</mark></p>
      )}
    </div>
  ))}
  {sheets.length === 0 && <p>No visible result worksheets found.</p>}
</div>

</div>
</main>
</Layout>
<style>
  .hidden { display: none; }

  .results-page {
    --results-surface: var(--color-brand-surface);
    --results-border: var(--color-brand-border);
    --results-accent: var(--color-brand-cyan);
    min-height: 75vh;
    /* The fixed menu starts 1rem down and is at least 4.35rem tall. */
    padding: 8rem clamp(1rem, 4vw, 3rem) 4rem;
  }

  :global(html[data-section-theme="light"]) .results-page {
    --results-surface: var(--color-section-light-surface);
    --results-border: var(--color-section-light-border);
    --results-accent: var(--color-brand-cyan-dark);
  }

  #results { scroll-margin-top: 8rem; }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .tab {
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--results-border);
    border-radius: 999px;
    background: var(--results-surface);
    color: inherit;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .tab:hover { border-color: var(--results-accent); }

  .tab.active {
    background: var(--color-brand-yellow);
    border-color: var(--color-brand-yellow);
    color: var(--color-brand-ink);
  }

  .tab:focus-visible {
    outline: 3px solid var(--results-accent);
    outline-offset: 3px;
  }

  .table-scroll {
    overflow-x: auto;
    border-radius: 8px;
  }

  table {
    line-height: 1.5;
    text-align: left;
  }

  th, td {
    /* white-space: pre-wrap; */
    /* overflow-wrap: break-word; */
    vertical-align: top;
    min-width: 7rem;
  }

  td[rowspan]:not([rowspan="1"]) { vertical-align: middle; }

  mark {
    background: var(--color-brand-yellow);
    color: var(--color-brand-ink);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  @media (max-width: 767px) {
    .results-page { padding-top: 7.5rem; }
    .modern-table th, .modern-table td { padding: 0.75rem; }
  }

 .curtain {
      position: fixed;
      top: 0;
      width: 50%;
      height: 100%;
      background-size: cover;
      background-repeat: no-repeat;
      z-index: 10;
      transition: transform 4.5s ease-in-out;
    }

    .left-curtain {
      left: 0;
      background-image: url(../assets/img/curtn-left.png); /* replace with your curtain img */
      transform: translateX(0%);
    }

    .right-curtain {
      right: 0;
      background-image: url(../assets/img/curtn-left.png); /* same image for example */
      transform: translateX(0%);
    }

    .open-left {
      transform: translateX(-100%);
    }

    .open-right {
      transform: translateX(100%);
    }

    .content {
      position: relative;
      z-index: 1;
      color: white;
      text-align: center;
      top: 40%;
      font-size: 2rem;
    }
  </style>


  <script>
 window.addEventListener('load', () => {
  const leftCurtain = document.querySelector('.left-curtain');
  const rightCurtain = document.querySelector('.right-curtain');
  const content = document.getElementById('main-content');

  if (leftCurtain && rightCurtain && content) {
    leftCurtain.classList.add('open-left');
    rightCurtain.classList.add('open-right');

    // Show the content after the curtain animation (4.5s)
    setTimeout(() => {
      content.classList.remove('hidden');
    }, 500);
  }
});

  
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const activeTab = document.querySelector('.tab.active');
      const activePanel = document.querySelector('.tab-panel.active');

      if (activeTab) {
        activeTab.classList.remove('active');
        activeTab.setAttribute('aria-pressed', 'false');
      }

      if (activePanel) {
        activePanel.classList.remove('active');
      }

      tab.classList.add('active');
      tab.setAttribute('aria-pressed', 'true');
      const tabIndex = tab.getAttribute('data-tab');
      const targetPanel = document.getElementById(`tab-${tabIndex}`);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });
</script>
